From 8c95624e35df046378c5289dc8fa06b89b052240 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E9=82=B5=E5=BA=B7?= <shaokang@schkzy.cn>
Date: Mon, 16 Nov 2026 01:24:44 +0800
Subject: [PATCH] fix(model): exclude last_called_at from full-row updates

[TM-FORK] UpdateWithTx writes the whole struct. Without this the field can be
overwritten with a stale snapshot read by the caller.
---
 model/user.go                  |  3 +++
 model/user_last_called_test.go | 22 ++++++++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/model/user.go b/model/user.go
index d6dcd620d..5359c0973 100644
--- a/model/user.go
+++ b/model/user.go
@@ -843,6 +843,9 @@ func (user *User) UpdateWithTx(tx *gorm.DB, updatePassword bool) error {
 		"aff_quota",
 		"aff_history",
 		"auth_version",
+		// [TM-FORK] 最近调用时刻只由扣费路径维护。编辑用户时整行覆盖会把它
+		// 写回调用方读到的旧值，必须在任何写路径上排除。
+		"last_called_at",
 	).Updates(newUser).Error; err != nil {
 		return err
 	}
diff --git a/model/user_last_called_test.go b/model/user_last_called_test.go
index 74eb2fa6a..e276102dc 100644
--- a/model/user_last_called_test.go
+++ b/model/user_last_called_test.go
@@ -102,3 +102,25 @@ func TestBatchFlushRefundDoesNotTouchLastCalledAt(t *testing.T) {
 	assert.Equal(t, -70, got.UsedQuota)
 	assert.Equal(t, int64(1700000000), got.LastCalledAt, "退款不是调用，不得刷新最近调用时刻")
 }
+
+// [TM-FORK] 编辑用户（整行覆盖）不得改写 last_called_at
+func TestUpdateWithTxKeepsLastCalledAt(t *testing.T) {
+	truncateTables(t)
+	user := &User{
+		Username: "lc_edit", Password: "password123",
+		Role: common.RoleCommonUser, Status: common.UserStatusEnabled, Group: "default",
+		LastCalledAt: 1700000000,
+	}
+	require.NoError(t, DB.Create(user).Error)
+
+	// 模拟从库里读出来、改了 display_name 再存回（老快照 LastCalledAt 仍是旧值）
+	stale := *user
+	stale.DisplayName = "改名"
+	stale.LastCalledAt = 1 // 故意塞一个旧值
+	require.NoError(t, stale.Update(false))
+
+	var got User
+	require.NoError(t, DB.First(&got, user.Id).Error)
+	assert.Equal(t, int64(1700000000), got.LastCalledAt, "编辑不得覆盖最近调用时刻")
+	assert.Equal(t, "改名", got.DisplayName)
+}
-- 
