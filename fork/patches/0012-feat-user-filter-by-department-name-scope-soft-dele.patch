--- a/controller/user.go
+++ b/controller/user.go
@@ -366,9 +366,22 @@ func SearchUsers(c *gin.Context) {
 			status = &parsed
 		}
 	}
+	// [TM-FORK] 部门 / 账号 / 显示名精确筛选
+	var departmentID *int
+	if v := strings.TrimSpace(c.Query("department_id")); v != "" {
+		parsed, err := strconv.Atoi(v)
+		if err != nil || parsed <= 0 {
