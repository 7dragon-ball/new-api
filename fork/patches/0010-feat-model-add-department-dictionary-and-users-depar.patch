diff --git a/model/department.go b/model/department.go
new file mode 100644
index 000000000..fd3df8c42
--- /dev/null
+++ b/model/department.go
@@ -0,0 +1,36 @@
+package model
+
+import (
+	"errors"
+	"strings"
+	"unicode/utf8"
+
+	"gorm.io/gorm"
+)
+
+// [TM-FORK] 部门名归一后为空或超长。message 会被 ApiError 原样渲染进响应体的
+// `message` 字段，前端直接展示，所以这句话本身就是给运营看的文案。
+var ErrDepartmentNameInvalid = errors.New("Department name must be 1-30 characters (spaces are trimmed)")
+
+// [TM-FORK] 部门字典：单层扁平，一人一部门。
+// 显式固定表名为单数 department：GORM 默认会复数化成 departments，而手写 SQL
+// （删除计数、部门用量聚合）都写 department。
+func (Department) TableName() string { return "department" }
+
+type Department struct {
+	Id        int    `json:"id"`
+	Name      string `json:"name" gorm:"type:varchar(30);not null;uniqueIndex:uk_department_name"`
+	CreatedAt int64  `json:"created_at" gorm:"autoCreateTime"`
+	UpdatedAt int64  `json:"updated_at" gorm:"autoUpdateTime"`
+}
+
+// [TM-FORK] 写入前归一：唯一索引生效的前提是库里存的已经归一。
+// 只在 Save / Create 路径生效；改名必须用 tx.Save(&dept) 而不是 Updates(map)，
+// 否则这个赋值写不进 SET 子句，重名检查随即失效。
+func (d *Department) BeforeSave(tx *gorm.DB) error {
+	d.Name = strings.TrimSpace(strings.ReplaceAll(d.Name, "　", " "))
+	if n := utf8.RuneCountInString(d.Name); n < 1 || n > 30 {
+		return ErrDepartmentNameInvalid
+	}
+	return nil
+}
diff --git a/model/department_test.go b/model/department_test.go
new file mode 100644
index 000000000..b90dadfa0
--- /dev/null
+++ b/model/department_test.go
@@ -0,0 +1,62 @@
+package model
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDepartmentTableNameIsSingular(t *testing.T) {
+	// 手写 SQL（删除计数、部门用量聚合）都写 department，靠 TableName 钉死单数。
+	assert.Equal(t, "department", Department{}.TableName())
+}
+
+func TestDepartmentBeforeSaveNormalizesName(t *testing.T) {
+	tests := []struct {
+		in      string
+		want    string
+		wantErr bool
+	}{
+		{in: "技术部", want: "技术部"},
+		{in: "  技术部  ", want: "技术部"},
+		{in: "技术部　", want: "技术部"}, // 全角空格也归一
+		{in: "", wantErr: true},
+		{in: "   ", wantErr: true},
+		{in: strings.Repeat("部", 31), wantErr: true},
+		{in: strings.Repeat("部", 30), want: strings.Repeat("部", 30)},
+	}
+	for _, tc := range tests {
+		dept := &Department{Name: tc.in}
+		err := dept.BeforeSave(DB)
+		if tc.wantErr {
+			assert.ErrorIs(t, err, ErrDepartmentNameInvalid, "input=%q", tc.in)
+			continue
+		}
+		require.NoError(t, err, "input=%q", tc.in)
+		assert.Equal(t, tc.want, dept.Name, "input=%q", tc.in)
+	}
+}
+
+func TestDepartmentBeforeSaveCountsRunesNotBytes(t *testing.T) {
+	// 30 个汉字是 90 字节；若按字节算会被误判超长。
+	name := strings.Repeat("部", 30)
+	dept := &Department{Name: name}
+	require.NoError(t, dept.BeforeSave(DB))
+	assert.Equal(t, name, dept.Name)
+}
+
+func TestDepartmentNameUniqueIndexRejectsDuplicate(t *testing.T) {
+	truncateDepartments(t)
+	first := &Department{Name: "技术部"}
+	require.NoError(t, DB.Create(first).Error)
+	// 归一后同名也必须被唯一索引挡住
+	second := &Department{Name: "  技术部 "}
+	assert.Error(t, DB.Create(second).Error)
+}
+
+func truncateDepartments(t *testing.T) {
+	t.Helper()
+	t.Cleanup(func() { DB.Exec("DELETE FROM department") })
+}
