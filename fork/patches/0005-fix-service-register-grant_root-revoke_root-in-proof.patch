From 46fd673d3628702815d8abbdf234b809675c2fef Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E9=82=B5=E5=BA=B7?= <shaokang@schkzy.cn>
Date: Fri, 13 Nov 2026 17:03:50 +0800
Subject: [PATCH 5/7] fix(service): register grant_root/revoke_root in proof
 action whitelist

---
 controller/security_enrollment_test.go | 3 +++
 service/security_verification.go       | 4 +++-
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/controller/security_enrollment_test.go b/controller/security_enrollment_test.go
index bb5a8e064..b88957554 100644
--- a/controller/security_enrollment_test.go
+++ b/controller/security_enrollment_test.go
@@ -786,6 +786,9 @@ func TestSecurityEnrollmentOperationContext(t *testing.T) {
 		{"admin user zero", "admin.user.delete", `{"user_id":0}`, service.ErrVerificationContextInvalid},
 		{"admin user extra field", "admin.user.update", `{"user_id":7,"password":"x"}`, service.ErrVerificationContextInvalid},
 		{"admin manage", "admin.user.manage", `{"user_id":7,"action":"promote"}`, nil},
+		// [TM-FORK] 多 root 新增 action 的绑定用例
+		{"admin manage grant_root", "admin.user.manage", `{"user_id":7,"action":"grant_root"}`, nil},
+		{"admin manage revoke_root", "admin.user.manage", `{"user_id":7,"action":"revoke_root"}`, nil},
 		{"admin manage quota", "admin.user.manage", `{"user_id":7,"action":"add_quota"}`, service.ErrVerificationContextInvalid},
 		{"admin manage delete", "admin.user.manage", `{"user_id":7,"action":"delete"}`, service.ErrVerificationContextInvalid},
 		{"admin binding type", "admin.user.binding.clear", `{"user_id":7,"binding_type":"github"}`, nil},
diff --git a/service/security_verification.go b/service/security_verification.go
index 2270b4d5d..4a23b8cea 100644
--- a/service/security_verification.go
+++ b/service/security_verification.go
@@ -50,7 +50,9 @@ const (
 
 // adminUserManageActions are the ManageUser actions that change a user's
 // status or role. Quota adjustments are not gated and deletion has its own scope.
-var adminUserManageActions = []string{"disable", "enable", "promote", "demote"}
+// [TM-FORK] grant_root / revoke_root 是多 root 方案新增的 action，必须在此登记，
+// 否则 BindVerificationOperation 会以 ErrVerificationContextInvalid 拒绝绑定。
+var adminUserManageActions = []string{"disable", "enable", "promote", "demote", "grant_root", "revoke_root"}
 
 var (
 	ErrVerificationFailed         = errors.New("Verification failed. Please try again.")
-- 
